package gc.mda.signal_batch.controller;

import gc.mda.signal_batch.dto.ChunkedTrackResponse;
import gc.mda.signal_batch.dto.TrackQueryRequest;
import gc.mda.signal_batch.service.ChunkedTrackStreamingService;
import gc.mda.signal_batch.service.StompTrackStreamingService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.messaging.handler.annotation.DestinationVariable;
import org.springframework.messaging.handler.annotation.MessageMapping;
import org.springframework.messaging.handler.annotation.Payload;
import org.springframework.messaging.simp.SimpMessagingTemplate;
import org.springframework.messaging.simp.annotation.SendToUser;
import org.springframework.stereotype.Controller;

import java.security.Principal;
import java.util.List;
import java.util.Map;
import java.util.UUID;
import java.util.concurrent.CompletableFuture;

/**
 * WebSocket STOMP 궤적 스트리밍 컨트롤러
 */
@Slf4j
@Controller
@RequiredArgsConstructor
public class StompTrackController {
    
    private final StompTrackStreamingService streamingService;
    private final ChunkedTrackStreamingService chunkedStreamingService;
    private final SimpMessagingTemplate messagingTemplate;
    
    /**
     * 궤적 쿼리 요청 처리
     */
    @MessageMapping("/tracks/query")
    @SendToUser("/queue/tracks/response")
    public void handleTrackQuery(@Payload TrackQueryRequest request, Principal principal) {
        String queryId = UUID.randomUUID().toString();
        log.info("Processing track query: {} for user: {}", queryId, principal.getName());
        
        // 응답 전송
        messagingTemplate.convertAndSendToUser(
            principal.getName(), 
            "/queue/tracks/response", 
            Map.of("queryId", queryId, "status", "STARTED")
        );
        
        // chunkedMode 확인
        if (request.isChunkedMode()) {
            // 압축된 청크 모드
            CompletableFuture.runAsync(() -> {
                try {
                    List<ChunkedTrackResponse> chunks = chunkedStreamingService.processQueryInChunks(request, queryId);
                    
                    // 청크별 전송
                    for (ChunkedTrackResponse chunk : chunks) {
                        messagingTemplate.convertAndSendToUser(
                            principal.getName(),
                            "/queue/tracks/chunk",
                            chunk
                        );
                        
                        // 진행률 업데이트
                        messagingTemplate.convertAndSendToUser(
                            principal.getName(),
                            "/queue/tracks/status",
                            Map.of(
                                "queryId", queryId,
                                "status", "PROCESSING",
                                "progressPercentage", chunk.getStats().getProgressPercentage()
                            )
                        );
                    }
                    
                    // 완료 상태 전송
                    messagingTemplate.convertAndSendToUser(
                        principal.getName(),
                        "/queue/tracks/status",
                        Map.of("queryId", queryId, "status", "COMPLETED")
                    );
                    
                } catch (Exception e) {
                    log.error("Error processing chunked query: {}", e.getMessage(), e);
                    messagingTemplate.convertAndSendToUser(
                        principal.getName(),
                        "/queue/errors",
                        Map.of("queryId", queryId, "message", e.getMessage())
                    );
                }
            });
        } else {
            // 기존 스트리밍 모드
            CompletableFuture.runAsync(() -> {
                streamingService.streamTrackData(request, queryId, principal.getName());
            });
        }
    }
    
    /**
     * 쿼리 취소
     */
    @MessageMapping("/tracks/cancel/{queryId}")
    public void cancelQuery(@DestinationVariable String queryId, Principal principal) {
        log.info("Cancelling query: {} for user: {}", queryId, principal.getName());
        streamingService.cancelQuery(queryId);
    }
}
